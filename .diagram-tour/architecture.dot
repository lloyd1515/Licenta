digraph ArchitectureTour {
  rankdir=LR;
  bgcolor="#0B0F19";
  fontname="Helvetica";
  fontcolor="#F8FAFC";
  compound=true;
  node [fontname="Helvetica", shape=box, style="rounded,filled", fillcolor="#111827", color="#334155", fontcolor="#F8FAFC", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#475569", fontcolor="#94A3B8"];
  graph [fontname="Helvetica", fontsize=11, fontcolor="#F8FAFC", labeljust="l"];

  // ─── Cluster 1: Hardware & Firmware ───────────────────
  subgraph cluster_hardware {
    label="Hardware and Firmware  (src/firmware)";
    style="rounded,filled"; color="#d97706"; fillcolor="#111827"; fontcolor="#fde68a";
    esp32_nodes     [label="esp32_csi_node\n3x ESP32 mesh nodes\n802.11n HT20 Channel 6", fillcolor="#1e293b", color="#f59e0b", fontcolor="#fef3c7"];
    wifi_csi_cb     [label="wifi_csi_rx_cb\npromiscuous CSI callback\n52 OFDM subcarriers I/Q", fillcolor="#1e293b", color="#f59e0b", fontcolor="#fef3c7"];
    uart_packet     [label="UART stream\n138-byte binary packets\nmagic 0xA55A @ 921600 baud", fillcolor="#1e293b", color="#f59e0b", fontcolor="#fef3c7"];
  }

  // ─── Cluster 2: Ingestion & Telemetry Engine ──────────
  subgraph cluster_ingestion {
    label="Ingestion and Telemetry Engine  (src/dsp_lab, src/gui)";
    style="rounded,filled"; color="#0284c7"; fillcolor="#111827"; fontcolor="#bae6fd";
    capture_serial  [label="capture_serial.py\nSerialNodeReader threads\npacket sync & demux", fillcolor="#1e293b", color="#38bdf8", fontcolor="#f0f9ff"];
    csi_data_engine [label="CSIDataEngine\nQThread backend stream\nlive UART + offline replay", fillcolor="#1e293b", color="#38bdf8", fontcolor="#f0f9ff"];
  }

  // ─── Cluster 3: DSP Pipeline ──────────────────────────
  subgraph cluster_dsp {
    label="DSP Pipeline  (src/dsp_lab)";
    style="rounded,filled"; color="#7c3aed"; fillcolor="#111827"; fontcolor="#ddd6fe";
    filters         [label="filters.py\nHampel filter (MAD)\nButterworth bandpass 0.2-10 Hz", fillcolor="#1e293b", color="#8b5cf6", fontcolor="#f5f3ff"];
    pca_module      [label="PCA First Component\nPC1 extraction\nsubcarrier variance collapse", fillcolor="#1e293b", color="#8b5cf6", fontcolor="#f5f3ff"];
    stft_doppler    [label="STFT Micro-Doppler\ntime-frequency spectrogram\nvelocity Doppler shift", fillcolor="#1e293b", color="#8b5cf6", fontcolor="#f5f3ff"];
  }

  // ─── Cluster 4: Decision & Spatial Reasoning ──────────
  subgraph cluster_decision {
    label="Decision and Spatial Reasoning  (src/dsp_lab)";
    style="rounded,filled"; color="#dc2626"; fillcolor="#111827"; fontcolor="#fecaca";
    fall_detector   [label="fall_detector.py\nFallDetectorFSM\n5 states: Calm, Move, Pre, Fall, Lie", shape=diamond, fillcolor="#1e293b", color="#ef4444", fontcolor="#fef2f2"];
    localization    [label="localization.py\nFresnel Ellipse 2D\nLevenberg-Marquardt tracking", fillcolor="#1e293b", color="#ef4444", fontcolor="#fef2f2"];
  }

  // ─── Cluster 5: Desktop User Interface ────────────────
  subgraph cluster_gui {
    label="Desktop User Interface  (src/gui)";
    style="rounded,filled"; color="#16a34a"; fillcolor="#111827"; fontcolor="#bbf7d0";
    app_window      [label="main_window.py\nPyQt6 Dark Industrial UI\nstate dispatch & alerts", fillcolor="#1e293b", color="#22c55e", fontcolor="#f0fdf4"];
    widgets         [label="widgets.py\nRoomMap · Waterfall\nDoppler · Telemetry", fillcolor="#1e293b", color="#22c55e", fontcolor="#f0fdf4"];
  }

  // ─── Cluster 6: Simulation & Validation ───────────────
  subgraph cluster_simulation {
    label="Simulation and Validation  (src/simulation-remotion, src/gui)";
    style="rounded,filled"; color="#db2777"; fillcolor="#111827"; fontcolor="#fbcfe8";
    sim_remotion    [label="simulation-remotion\nReact · Remotion · Three.js\n3D Fresnel wave physics", fillcolor="#1e293b", color="#ec4899", fontcolor="#fdf2f8"];
    verify_evidence [label="verify_gui_evidence.py\noffscreen QTest suite\n24/24 visual screenshots", fillcolor="#1e293b", color="#ec4899", fontcolor="#fdf2f8"];
  }

  // ─── Edges & Data Flow ────────────────────────────────
  esp32_nodes -> wifi_csi_cb       [label="802.11n frames", color="#f59e0b"];
  wifi_csi_cb -> uart_packet       [label="138B struct", color="#f59e0b"];
  uart_packet -> capture_serial    [label="UART read", color="#38bdf8"];
  uart_packet -> csi_data_engine   [label="live frames", color="#38bdf8"];
  capture_serial -> csi_data_engine [label=".npz replay datasets", style=dashed, color="#64748b"];

  csi_data_engine -> filters       [label="raw CSI amplitudes", color="#8b5cf6"];
  filters -> pca_module            [label="denoised subcarriers", color="#8b5cf6"];
  pca_module -> stft_doppler       [label="PC1 time series", color="#8b5cf6"];
  pca_module -> fall_detector      [label="energy metrics", color="#ef4444"];
  stft_doppler -> fall_detector    [label="Doppler peak > 35 Hz", color="#ef4444"];
  pca_module -> localization       [label="link attenuation", color="#ef4444"];

  fall_detector -> csi_data_engine [label="FSM state & alert", color="#38bdf8"];
  localization -> csi_data_engine  [label="avatar coords (x,y)", color="#38bdf8"];

  csi_data_engine -> app_window    [label="sig_frame_ready (30-60 FPS)", color="#22c55e"];
  app_window -> widgets            [label="render updates", color="#22c55e"];

  localization -> sim_remotion     [label="Fresnel model params", style=dashed, color="#ec4899"];
  app_window -> verify_evidence    [label="headless QTest audit", style=dashed, color="#ec4899"];
}
