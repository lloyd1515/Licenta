#!/usr/bin/env bash
BASE_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
export GVBINDIR="$BASE_DIR/.local/usr/lib64/graphviz"
export LD_LIBRARY_PATH="$BASE_DIR/.local/usr/lib64:$BASE_DIR/.local/usr/lib64/graphviz${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$BASE_DIR/.local/usr/bin/dot" "$@"
